METHODS_HBONDS = ['gmx', 'mda']
# Mutation to analyze
MUT = ['wt', 'T419R', 'S466R'] 

# List to store mutation-sample pairs as tuples
mut_sample_pairs = []

# Get first-level directories starting with rep for each mutation in MUT
for mutation in MUT:
    sample_names = [d for d in os.listdir(f"../../data/1bf5/{mutation}/") 
                   if os.path.isdir(os.path.join(f"../../data/1bf5/{mutation}/", d)) 
                   and d.startswith("rep")]
    # Create pairs for this mutation
    for sample in sample_names:
        mut_sample_pairs.append((mutation, sample))

# Print the pairs
for mutation, sample in mut_sample_pairs:
    print(f"Mutation: {mutation}, Sample: {sample}")


# Alternatively, manually define mutation-replicate pairs to be analyzed
# mut_sample_pairs = [('T419R', 'rep3')]

print(mut_sample_pairs)

mutations, samples = zip(*mut_sample_pairs)

