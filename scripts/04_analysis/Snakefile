rule clustering_gromos:
    input: 
        proj_timescale = "../../data/1bf5/{mut}/{sample}/analysis/003_pca/2dproj_timescale.csv",
        tpr = "../../data/1bf5/{mut}/{sample}/gromacs/md.tpr",
        xtc = "../../data/1bf5/{mut}/{sample}/gromacs/md_noPBC_mol_com_cluster_fit.xtc"
    output: 
        gromos_index = "../../data/1bf5/{mut}/{sample}/analysis/005_clustering/gromos_clusters.ndx",
        gromos_xpm = "../../data/1bf5/{mut}/{sample}/analysis/005_clustering/gromos_clusters.xpm",
        gromos_log = "../../data/1bf5/{mut}/{sample}/analysis/005_clustering/gromos_clusters.log",
        rmsd_dist = "../../data/1bf5/{mut}/{sample}/analysis/005_clustering/rmsd-dist.xvg",
    shell: 
        """
        bash -c '
        outdir="../../data/1bf5/{wildcards.mut}/{wildcards.sample}/analysis/005_clustering"

        if [ ! -d "$outdir" ]; then
            mkdir "$outdir"
            echo "Creating directory: $outdir"
        else
            echo "Directory already exists: $outdir"
        fi

        source /opt/gromacs/gromacs_2024/bin/GMXRC.bash

        gmx cluster -f {input.xtc} -s {input.tpr} -method gromos -cutoff 0.2 \
            -o {output.gromos_xpm} -g {output.gromos_log} -clndx {output.gromos_index} -dist {output.rmsd_dist} -quiet << EOL
        C-alpha
        C-alpha
        EOL
        '
        """

