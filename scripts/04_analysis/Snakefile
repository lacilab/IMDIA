# Usage
# snakemake --config structure="A,B,C" muts="1,2,3" 

# Hydrogen bond analysis methods
METHODS_HBONDS = ['gmx', 'mda']

# Structures to analyze
STRUCTURES = config["structure"].split(",") if "structure" in config else []
# Mutations to analyze
MUTS = config["muts"].split(",") if "muts" in config else []

# List to store mutation-sample pairs as tuples
combinations = []

# Get first-level directories starting with rep for each mutation in MUTS
for structure in STRUCTURES:
    for mutation in MUTS:
        reps = [d for d in os.listdir(f"../../data/{structure}/{mutation}/") 
                    if os.path.isdir(os.path.join(f"../../data/{structure}/{mutation}/", d)) 
                    and d.startswith("rep")]
        # Create pairs for this mutation
        for rep in reps:
            combinations.append((structure, mutation, rep))

# Print the pairs
print ("Structure-Mutation-Sample combinations to be analyzed:")
for structure, mutation, rep in mut_sample_pairs:
    print(f"Structure: {structure}, Mutation: {mutation}, Replicate: {rep}")

structures, mutations, reps = zip(*combinations)

# PATHS
BASE_PATH = "../../data/{struct}/{mut}/{rep}/analysis"
QC_PATH = f"{BASE_PATH}/001_qc"
HBONDS_PATH = f"{BASE_PATH}/002_hbonds"
PCA_PATH = f"{BASE_PATH}/003_pca"
CONTACTS_PATH = f"{BASE_PATH}/004_contacts"
CLUST_PATH = f"{BASE_PATH}/005_clustering"
GBSA_PATH = f"{BASE_PATH}/006_gbsa"


rule all:
    input:
        # QC
        rmsdpng = expand(f"{QC_PATH}/rmsd.png", struct=structures, mut=mutations, rep=reps, zip=True),
        rmsd_cats = expand(f"{QC_PATH}/rmsd_cats.png", struct=structures, mut=mutations, rep=reps, zip=True),
        rmsd_bb = expand(f"{QC_PATH}/rmsd_bb.png", struct=structures, mut=mutations, rep=reps, zip=True),
        radius_axis = expand(f"{QC_PATH}/radius_axis.png", struct=structures, mut=mutations, rep=reps, zip=True),
        radius_rmsd = expand(f"{QC_PATH}/radius_rmsd.png", struct=structures, mut=mutations, rep=reps, zip=True),
        rmsf_prot_domains = expand(f"{QC_PATH}/rmsf_prot_domains.png", struct=structures, mut=mutations, rep=reps, zip=True),
