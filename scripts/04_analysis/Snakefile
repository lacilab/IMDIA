        radius_axis_csv = expand(f"{QC_PATH}/radius_axis.csv", struct=structures, mut=mutations, rep=reps, zip=True),
        rmsf_prot_csv = expand(f"{QC_PATH}/rmsf_prot.csv", struct=structures, mut=mutations, rep=reps, zip=True),
        rmsf_dna_csv = expand(f"{QC_PATH}/rmsf_dna.csv", struct=structures, mut=mutations, rep=reps, zip=True),
        
        # HBONDS
        hbonds_mda_parsed = expand(f"{HBONDS_PATH}/hbonds_mda_parsed.csv", struct=structures, mut=mutations, rep=reps, zip=True),

        hbonds_gmx = expand(f"{HBONDS_PATH}/hbonds_gmx.ndx", struct=structures, mut=mutations, rep=reps, zip=True),
        hbonds_gmx_num = expand(f"{HBONDS_PATH}/hbonds_gmx_num.xvg", struct=structures, mut=mutations, rep=reps, zip=True),
        hbonds_gmx_parsed = expand(f"{HBONDS_PATH}/hbonds_gmx_parsed.csv", struct=structures, mut=mutations, rep=reps, zip=True),

        hbonds_perframe = expand(f"{HBONDS_PATH}/hbonds_{method}_perframe.png", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),
        hbonds_ext = expand(f"{HBONDS_PATH}/hbonds_{method}_ext.csv", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),

        hbonds_prot_domains = expand(f"{HBONDS_PATH}/hbonds_{method}_prot_domain.png", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),
        hbonds_prot_monomer = expand(f"{HBONDS_PATH}/hbonds_{method}_monomer.png", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),
        hbonds_dna = expand(f"{HBONDS_PATH}/hbonds_{method}_dna.png", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),
        hbonds_dna_bb = expand(f"{HBONDS_PATH}/hbonds_{method}_dna_bb.png", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),
        hbonds_dna_base = expand(f"{HBONDS_PATH}/hbonds_{method}_dna_base.png", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),

        hbonds_pymol = expand(f"{HBONDS_PATH}/hbonds_{method}_pymol.txt", struct=structures, mut=mutations, rep=reps, zip=True, method=METHODS_HBONDS),

        # WATER BRIDGES
        water_bridges = expand(f"{HBONDS_PATH}/waterbridges.csv", struct=structures, mut=mutations, rep=reps, zip=True),

