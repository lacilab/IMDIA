rule clustering_sklearn:
    input: 
        pdb = "../../data/{struct}/{mut}/{sample}/gromacs/md_sys.pdb",
        xtc = "../../data/{struct}/{mut}/{sample}/gromacs/md_noPBC_mol_com_cluster_fit.xtc"
    output: 
        summary = report(f"{CLUST_PATH}/analysis_summary.txt",  
                    category="Clustering", labels={"sample": "{mut} {sample} Summary"}),
        hclust = f"{CLUST_PATH}/hclust_labels.csv",
        kmeans = f"{CLUST_PATH}/kmeans_labels.csv",
        hclust_timeline = report(f"{CLUST_PATH}/hclust_cluster_timeline.png",
                        category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {sample} Timeline"}),
        kmeans_timeline = report(f"{CLUST_PATH}/kmeans_cluster_timeline.png",
                            category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {sample} Timeline"}),
        umap_timeline = report(f"{CLUST_PATH}/umap_3d_timeline.png",
                            category="Clustering", labels={"sample": "{mut} {sample} UMAP timeline"}),
        umap_hclust_clusters = report(f"{CLUST_PATH}/umap_hclust_clusters.png",
                                category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {sample} Overlay on UMAP"}),
        umap_kmeans_clusters = report(f"{CLUST_PATH}/umap_kmeans_clusters.png",
                                category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {sample} Overlay on UMAP"}),
        umap_optimization = report(f"{CLUST_PATH}/umap_optimization.png",
                                category="Clustering", labels={"sample": "{mut} {sample} UMAP Optimization"}),
        pca_sk_hclust = report(f"{CLUST_PATH}/pca_sklearn_clusters_hclust.png",
                             category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {sample} Overlay on sklearn PCA"}),
        pca_sk_kmeans = report(f"{CLUST_PATH}/pca_sklearn_clusters_kmeans.png",
                            category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {sample} Overlay on sklearn PCA"}),
    shell:
        """
        outdir="../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/005_clustering"

        if [ ! -d "$outdir" ]; then
            mkdir "$outdir"
            echo "Creating directory: $outdir"
        else
            echo "Directory already exists: $outdir"
        fi

        python clustering_sklearn.py \
            {input.pdb} \
            {input.xtc} \
            "../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/005_clustering" \
        """

