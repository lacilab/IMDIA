        porcupine = expand(f"{PCA_PATH}/porcupine.png", struct=structures, mut=mutations, rep=reps, zip=True),

        # CLUSTERING
        summary = expand(f"{CLUST_PATH}/analysis_summary.txt", struct=structures, mut=mutations, rep=reps, zip=True),
        hclust = expand(f"{CLUST_PATH}/hclust_labels.csv", struct=structures, mut=mutations, rep=reps, zip=True),
