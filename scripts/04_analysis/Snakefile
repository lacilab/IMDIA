        hbonds_dna = report("../../data/1bf5/{mut}/{sample}/analysis/002_hbonds/hbonds_{method}_dna.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per DNA chain and residue"}),
        hbonds_dna_bb = report("../../data/1bf5/{mut}/{sample}/analysis/002_hbonds/hbonds_{method}_dna_bb.png", 
