rule hbonds_extend:
    input: 
        universe = f"{BASE_PATH}/000_raw/universe",
        hbonds_parsed = f"{HBONDS_PATH}/hbonds_{method}_parsed.csv",
        pdb = "../../data/{struct}/{mut}/{sample}/gromacs/md_sys.pdb",
    output: 
        hbonds_ext = f"{HBONDS_PATH}/hbonds_{method}_ext.csv",
        hbonds_perframe = report(f"{HBONDS_PATH}/hbonds_{method}_perframe.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per frame (last 100ns)"})
    shell: 
        """
        python hbonds_extend.py \
            {input.universe} \
            {input.hbonds_parsed} \
            {input.pdb} \
            {output.hbonds_ext} \
            {output.hbonds_perframe} \
        """

rule hbonds_plots:
    input: 
        hbonds_ext = f"{HBONDS_PATH}/hbonds_{method}_ext.csv",
    output: 
        hbonds_prot_domains = report(f"{HBONDS_PATH}/hbonds_{method}_prot_domain.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per protein domain and residue"}),
        hbonds_prot_monomer = report(f"{HBONDS_PATH}/hbonds_{method}_monomer.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per protein monomer and atom"}),
        hbonds_dna = report(f"{HBONDS_PATH}/hbonds_{method}_dna.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per DNA chain and residue"}),
        hbonds_dna_bb = report(f"{HBONDS_PATH}/hbonds_{method}_dna_bb.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per DNA backbone"}),
        hbonds_dna_base = report(f"{HBONDS_PATH}/hbonds_{method}_dna_base.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per DNA base"})
    shell: 
        """
        python hbonds_plots.py \
            {input.hbonds_ext} \
            {output.hbonds_prot_domains} \
            {output.hbonds_prot_monomer} \
            {output.hbonds_dna} \
            {output.hbonds_dna_bb} \
            {output.hbonds_dna_base} 
        """

