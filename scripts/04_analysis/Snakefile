        """

rule clustering_pca_gromos:
    input: 
        proj_timescale = f"{PATH_PCA}/2dproj_timescale.csv",
        gromos_index = f"{PATH_CLUST}/gromos_clusters.ndx",
    output: 
        pca_gromos = report(f"{PATH_CLUST}/pca_gromos_clusters.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {rep} Overlay on gmx PCA"}),
        pca_gromos_top10 = report(f"{PATH_CLUST}/pca_gromos_clusters_top10.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {rep} Overlay on gmx PCA, top 10 clusters"}),
        gromos_clusters_freq = report(f"{PATH_CLUST}/gromos_clusters_freq.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {rep} Cluster frequencies"}),
        gromos_clusters_freqcum = report(f"{PATH_CLUST}/gromos_clusters_freq_cum.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {rep} Cluster cumulative frequencies"}),
    shell: 
        """
        scripts/clustering_pca_gromos.py \
            --timescale {input.proj_timescale} \
            --index {input.gromos_index} \
            --outdir "{PATH_ANALYSIS_WC}/005_clustering" \
        """

rule clustering_pca_gmx:
    input: 
        proj_timescale = f"{PATH_PCA}/2dproj_timescale.csv",
        hclust = f"{PATH_CLUST}/hclust_labels.csv",
        kmeans = f"{PATH_CLUST}/kmeans_labels.csv",
    output: 
        pca_gmx_hclust = report(f"{PATH_CLUST}/pca_gmx_clusters_hclust.jpg", 
                        category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {rep} Overlay on gmx PCA"}),
        pca_gmx_kmeans = report(f"{PATH_CLUST}/pca_gmx_clusters_kmeans.jpg",
                         category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {rep} Overlay on gmx PCA"}),
    shell:
        """
        scripts/clustering_pca_gmx.py \
            --timescale {input.proj_timescale} \
            --labels {input.hclust} \
            --outdir "{PATH_ANALYSIS_WC}/005_clustering" \

        scripts/clustering_pca_gmx.py \
            --timescale {input.proj_timescale} \
            --labels {input.kmeans} \
            --outdir "{PATH_ANALYSIS_WC}/005_clustering" \
        """

rule gbsa:
    input: 
        tpr = f"{PATH_GMX}/md.tpr",
        xtc = f"{PATH_GMX}/md_noPBC_mol_com_cluster_fit.xtc",
        top = f"{PATH_MUT}/gromacs_common/topol.top",
        index = f"{PATH_GMX}/indexmd.ndx",
    output: 
        gbsa_info = f"{PATH_GBSA}/_GMXMMPBSA_info",
        gbsa_final_results = f"{PATH_GBSA}/FINAL_RESULTS_MMPBSA.dat",
        gbsa_final_decomp = f"{PATH_GBSA}/FINAL_DECOMP_MMPBSA.dat",
        gbsa_energy = f"{PATH_GBSA}/FINAL_ENERGY.csv",
        gbsa_energy_decomp = f"{PATH_GBSA}/FINAL_ENERGY_DECOMP.csv",
    shell: 
        """
        scripts/MMPBSA.sh \
            --tpr {input.tpr} \
            --xtc {input.xtc} \
            --top {input.top} \
            --index {input.index} \
            --outdir "{PATH_ANALYSIS_WC}/006_gbsa"
        """
