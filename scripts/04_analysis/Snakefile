rule universe:
    input:
        pdb = "../../data/{struct}/{mut}/{sample}/gromacs/md_sys.pdb",
        xtc = "../../data/{struct}/{mut}/{sample}/gromacs/md_noPBC_mol_com_cluster_fit.xtc"
    output:
        universe = f"{BASE_PATH}/000_raw/universe"
    shell:
        """
        python universe.py \
            "../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/000_raw" \
            {input.pdb} \
            {input.xtc} \
            {output.universe}
       """

rule qc:
    input: 
        universe = f"{BASE_PATH}/000_raw/universe"
    output:
        rmsd = report(f"{QC_PATH}/rmsd.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} RMSD"}),
        rmsd_cats = report(f"{QC_PATH}/rmsd_cats.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} RMSD by category"}),
        rmsd_bb = report(f"{QC_PATH}/rmsd_bb.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} RMSD Backbone"}),
        radius_axis = report(f"{QC_PATH}/radius_axis.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} Radius of gyration"}),
        radius_rmsd = report(f"{QC_PATH}/radius_rmsd.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} Radius of gyration vs RMSD"}),
        rmsf_prot_domains = report(f"{QC_PATH}/rmsf_prot_domains.png", 
            category="QC", subcategory="RMSF", labels={"sample": "{mut} {sample} RMSF Protein"}),
        rmsf_dna_res = report(f"{QC_PATH}/rmsf_dna_res.png", 
            category="QC", subcategory="RMSF", labels={"sample": "{mut} {sample} RMSF DNA"}),
        
        rmsd_csv = f"{QC_PATH}/rmsd.csv",
        radius_axis_csv = f"{QC_PATH}/radius_axis.csv",
        rmsf_prot_csv = f"{QC_PATH}/rmsf_prot.csv",
        rmsf_dna_csv = f"{QC_PATH}/rmsf_dna.csv",
    shell:
       """
       python qc.py \
            "../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/001_qc" \
            {input.universe} \
            {output.rmsd} \
            {output.rmsd_cats} \
            {output.rmsd_bb} \
            {output.radius_axis} \
            {output.radius_rmsd} \
            {output.rmsf_prot_domains} \
            {output.rmsf_dna_res} \
            {output.rmsd_csv} \
            {output.radius_axis_csv} \
            {output.rmsf_prot_csv} \
            {output.rmsf_dna_csv}
       """

