rule universe:
    input:
        pdb = "../../data/1bf5/{mut}/{sample}/gromacs/md_sys.pdb",
        xtc = "../../data/1bf5/{mut}/{sample}/gromacs/md_noPBC_mol_com_cluster_fit.xtc"
    output:
        universe = "../../data/1bf5/{mut}/{sample}/analysis/000_raw/universe"
    shell:
        """
        python universe.py \
            "../../data/1bf5/{wildcards.mut}/{wildcards.sample}/analysis/000_raw" \
            {input.pdb} \
            {input.xtc} \
            {output.universe}
       """

rule qc:
    input: 
        universe = "../../data/1bf5/{mut}/{sample}/analysis/000_raw/universe"
    output:
