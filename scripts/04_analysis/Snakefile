        gromos_xpm = f"{CLUST_PATH}/gromos_clusters.xpm",
        gromos_log = f"{CLUST_PATH}/gromos_clusters.log",
        rmsd_dist = f"{CLUST_PATH}/rmsd-dist.xvg",
    shell: 
        """
        bash -c '
        outdir="../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/005_clustering"

        if [ ! -d "$outdir" ]; then
            mkdir "$outdir"
            echo "Creating directory: $outdir"
        else
            echo "Directory already exists: $outdir"
        fi

        source /opt/gromacs/gromacs_2024/bin/GMXRC.bash

        gmx cluster -f {input.xtc} -s {input.tpr} -method gromos -cutoff 0.2 \
            -o {output.gromos_xpm} -g {output.gromos_log} -clndx {output.gromos_index} -dist {output.rmsd_dist} -quiet << EOL
        C-alpha
        C-alpha
        EOL
        '
        """

rule clustering_gromos_pca:
    input: 
        proj_timescale = f"{PCA_PATH}/2dproj_timescale.csv",
        gromos_index = f"{CLUST_PATH}/gromos_clusters.ndx",
    output: 
        pca_gromos = report(f"{CLUST_PATH}/pca_gromos_clusters.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {sample} Overlay on gmx PCA"}),
        pca_gromos_top10 = report(f"{CLUST_PATH}/pca_gromos_clusters_top10.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {sample} Overlay on gmx PCA, top 10 clusters"}),
        gromos_clusters_freq = report(f"{CLUST_PATH}/gromos_clusters_freq.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {sample} Cluster frequencies"}),
        gromos_clusters_freqcum = report(f"{CLUST_PATH}/gromos_clusters_freq_cum.png", 
            category="Clustering", subcategory="Gromos clustering", labels={"sample": "{mut} {sample} Cluster cumulative frequencies"}),
    shell: 
        """
        python clustering_gromos.py \
            {input.proj_timescale} \
            {input.gromos_index} \
            "../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/005_clustering" \
        """

rule clustering_pca_gmx:
    input: 
        proj_timescale = f"{PCA_PATH}/2dproj_timescale.csv",
        hclust = f"{CLUST_PATH}/hclust_labels.csv",
        kmeans = f"{CLUST_PATH}/kmeans_labels.csv",
    output: 
        pca_gmx_hclust = report(f"{CLUST_PATH}/pca_gmx_clusters_hclust.jpg", 
                        category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {sample} Overlay on gmx PCA"}),
        pca_gmx_kmeans = report(f"{CLUST_PATH}/pca_gmx_clusters_kmeans.jpg",
                         category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {sample} Overlay on gmx PCA"}),
    shell:
        """
        python clustering_pca_gmx.py \
            {input.proj_timescale} \
            {input.hclust} \
            "hclust" \
            "../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/005_clustering" \

        python clustering_pca_gmx.py \
            {input.proj_timescale} \
            {input.kmeans} \
            "kmeans" \
            "../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/005_clustering" \
        """

rule gbsa:
    input: 
        tpr = "../../data/{struct}/{mut}/{sample}/gromacs/md.tpr",
        xtc = "../../data/{struct}/{mut}/{sample}/gromacs/md_noPBC_mol_com_cluster_fit.xtc",
        top = "../../data/{struct}/{mut}/gromacs_common/topol.top",
        index = "../../data/{struct}/{mut}/{sample}/gromacs/indexmd.ndx",
    output: 
        gbsa_info = f"{GBSA_PATH}/_GMXMMPBSA_info",
        gbsa_final_results = f"{GBSA_PATH}/FINAL_RESULTS_MMPBSA.dat",
        gbsa_final_decomp = f"{GBSA_PATH}/FINAL_DECOMP_MMPBSA.dat",
        gbsa_energy = f"{GBSA_PATH}/FINAL_ENERGY.csv",
        gbsa_energy_decomp = f"{GBSA_PATH}/FINAL_ENERGY_DECOMP.csv",
    shell: 
        """
        bash MMPBSA.sh \
            "md.tpr" \
            "md_noPBC_mol_com_cluster_fit.xtc" \
            "topol.top" \
            "indexmd.ndx" \
            "../../data/{struct}/{wildcards.mut}/{wildcards.sample}/analysis/006_gbsa"
        """
