rule hbonds_extend:
    input: 
        universe = f"{BASE_PATH}/000_raw/universe",
        hbonds_parsed = f"{PATH_HBONDS}/hbonds_{method}_parsed.csv",
        pdb = f"{PATH_GMX}/md_sys.pdb",
    output: 
        hbonds_ext = f"{PATH_HBONDS}/hbonds_{method}_ext.csv",
        hbonds_perframe = report(f"{PATH_HBONDS}/hbonds_{method}_perframe.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per frame (last 100ns)"})
    shell: 
        """
        scripts/hbonds_extend.py \
            --pdb {input.pdb} \
            --universe {input.universe} \
            --hbonds_parsed {input.hbonds_parsed} \
            --hbonds_ext {output.hbonds_ext} \
            --hbonds_perframe {output.hbonds_perframe} \
        """

rule hbonds_plots:
    input: 
        hbonds_ext = f"{PATH_HBONDS}/hbonds_{method}_ext.csv",
    output: 
        hbonds_prot_domains = report(f"{PATH_HBONDS}/hbonds_{method}_prot_domain.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per protein domain and residue"}),
        hbonds_prot_monomer = report(f"{PATH_HBONDS}/hbonds_{method}_monomer.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per protein monomer and atom"}),
        hbonds_dna = report(f"{PATH_HBONDS}/hbonds_{method}_dna.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per DNA chain and residue"}),
        hbonds_dna_bb = report(f"{PATH_HBONDS}/hbonds_{method}_dna_bb.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per DNA backbone"}),
        hbonds_dna_base = report(f"{PATH_HBONDS}/hbonds_{method}_dna_base.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per DNA base"})
    shell: 
        """
        scripts/hbonds_plots.py \
            --incsv {input.hbonds_ext} \
            --method {method} \
            --outdir "{PATH_ANALYSIS_WC}/002_hbonds" \
        """

