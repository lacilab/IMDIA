        rmsd_cats = report("../../data/1bf5/{mut}/{sample}/analysis/001_qc/rmsd_cats.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} RMSD by category"}),
        rmsd_bb = report("../../data/1bf5/{mut}/{sample}/analysis/001_qc/rmsd_bb.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} RMSD Backbone"}),
        radius_axis = report("../../data/1bf5/{mut}/{sample}/analysis/001_qc/radius_axis.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} Radius of gyration"}),
        radius_rmsd = report("../../data/1bf5/{mut}/{sample}/analysis/001_qc/radius_rmsd.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {sample} Radius of gyration vs RMSD"}),
        rmsf_prot_domains = report("../../data/1bf5/{mut}/{sample}/analysis/001_qc/rmsf_prot_domains.png", 
            category="QC", subcategory="RMSF", labels={"sample": "{mut} {sample} RMSF Protein"}),
        rmsf_dna_res = report("../../data/1bf5/{mut}/{sample}/analysis/001_qc/rmsf_dna_res.png", 
            category="QC", subcategory="RMSF", labels={"sample": "{mut} {sample} RMSF DNA"}),
        
        rmsd_csv = "../../data/1bf5/{mut}/{sample}/analysis/001_qc/rmsd.csv",
        radius_axis_csv = "../../data/1bf5/{mut}/{sample}/analysis/001_qc/radius_axis.csv",
