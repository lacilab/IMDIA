rule hbonds_extend:
    input: 
        universe = "../../data/1bf5/{mut}/{sample}/analysis/000_raw/universe",
        hbonds_parsed = "../../data/1bf5/{mut}/{sample}/analysis/002_hbonds/hbonds_{method}_parsed.csv",
        pdb = "../../data/1bf5/{mut}/{sample}/gromacs/md_sys.pdb",
    output: 
        hbonds_ext = "../../data/1bf5/{mut}/{sample}/analysis/002_hbonds/hbonds_{method}_ext.csv",
        hbonds_perframe = report("../../data/1bf5/{mut}/{sample}/analysis/002_hbonds/hbonds_{method}_perframe.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {sample} Hbonds per frame (last 100ns)"})
    shell: 
        """
        python hbonds_extend.py \
            {input.universe} \
            {input.hbonds_parsed} \
            {input.pdb} \
            {output.hbonds_ext} \
            {output.hbonds_perframe} \
        """

rule hbonds_plots:
