rule gbsa:
    params:
        index_group1 = lambda wc, input: __import__("json").load(open(input.groups))["group1"],
        index_group2 = lambda wc, input: __import__("json").load(open(input.groups))["group2"],
        gmxdir = lambda wc: f"{PATH_GMX_WC(wc)}",
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/006_gbsa_{GROUP1}_{GROUP2}",
        scriptdir = SCRIPTDIR,
    threads: min(int(workflow.cores * 0.95), 64)
    input: 
        tpr = f"{PATH_GMX}/md.tpr",
        xtc = f"{PATH_GMX}/md_post.xtc",
        top = f"{PATH_MUT}/gromacs_common/topol.top",
        index = f"{PATH_GMX}/interaction_{GROUP1}_{GROUP2}.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    output: 
        gbsa_info = f"{PATH_GBSA}/_GMXMMPBSA_info",
        gbsa_final_results = f"{PATH_GBSA}/FINAL_RESULTS_MMPBSA.dat",
        gbsa_final_decomp = f"{PATH_GBSA}/FINAL_DECOMP_MMPBSA.dat",
        gbsa_energy = f"{PATH_GBSA}/FINAL_ENERGY.csv",
        gbsa_energy_decomp = f"{PATH_GBSA}/FINAL_ENERGY_DECOMP.csv",
    run:
        from scripts_analysis.gbsa import main
        main(
            logfile=LOGFILE,
            scriptdir=params.scriptdir,
            gmxdir=params.gmxdir,
            outdir=params.outdir,
            index = input.index,
            tprfile=input.tpr,
            xtcfile=input.xtc,
            topfile=input.top,
            cores=threads,
            index_group1=params.index_group1,
            index_group2=params.index_group2,
            start=START,
            stop=STOP,
            dna=DNA,
            phos=PHOS,
            ffs=FFS
        )