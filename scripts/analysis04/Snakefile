rule all:
    input:
        **all_input
    run:
        print("+-----------------------------------------+")
        print("|   STARTING ANALYSIS OF MD RESULTS  |")
        print("+-----------------------------------------+")

rule universe:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/000_raw"
    input:
        pdb = f"{PATH_GMX}/md_sys.pdb",
        xtc = f"{PATH_GMX}/md_post.xtc"
    output:
        universe = f"{PATH_RAW}/universe"
    run:
        from scripts_analysis.universe import main
        main(
            logfile=logfile,
            pdbfile=input.pdb,
            xtcfile=input.xtc,
            outdir=params.outdir,
            universe=output.universe
        )
    #shell:
    #    """
    #    {SCRIPTDIR}/universe.py \
    #        --logfile {logfile} \
    #        --pdb {input.pdb} \
    #        --xtc {input.xtc} \
    #        --outdir "{PATH_ANALYSIS_WC}/000_raw" \
    #        --universe {output.universe} \
    #   """

rule qc:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/001_qc"
    input: 
        universe = f"{PATH_RAW}/universe"
    output:
        rmsd = report(f"{PATH_QC}/rmsd.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} RMSD"}),
        rmsd_cats = report(f"{PATH_QC}/rmsd_cats.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} RMSD by category"}),
        rmsd_bb = report(f"{PATH_QC}/rmsd_bb.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} RMSD Backbone"}),
        radius_axis = report(f"{PATH_QC}/radius_axis.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} Radius of gyration"}),
        radius_rmsd = report(f"{PATH_QC}/radius_rmsd.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} Radius of gyration vs RMSD"}),
        rmsf_prot_domains = report(f"{PATH_QC}/rmsf_prot_domains.png", 
            category="QC", subcategory="RMSF", labels={"sample": "{mut} {rep} RMSF Protein"}),
        rmsd_csv = f"{PATH_QC}/rmsd.csv",
        radius_axis_csv = f"{PATH_QC}/radius_axis.csv",
        rmsf_prot_csv = f"{PATH_QC}/rmsf_prot.csv",
        **out_rmsf_dna
    run:
        from scripts_analysis.qc import main
        main(
            logfile=logfile,
            universe=input.universe,
            outdir=params.outdir,
            outfiles=dict(output),
            with_dna=DNA,
            offset=OFFSET,
            domains=DOMAINS
        )
    #shell:
    #   """
    #   {SCRIPTDIR}/qc.py \
    #        --logfile {logfile} \
    #        --universe {input.universe} \
    #        --outdir "data/{wildcards.struct}/{wildcards.mut}/{wildcards.rep}/analysis/001_qc" \
    #        --offset {OFFSET} \
    #        --domains {DOMAINS} \
    #   """


# Get interaction group names in the index file
rule interaction_index:
    params:
        gmxdir = lambda wc: f"{PATH_GMX_WC(wc)}",
    input:
        pdb = f"{PATH_GMX}/md_sys.pdb",
    output:
        index = f"{PATH_GMX}/interaction_{GROUP1}_{GROUP2}.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    run:
        from scripts.utils.group_index import group_index_interactions
        import json

        index_group1, index_group2 = group_index_interactions(gmxdir=params.gmxdir, logfile=logfile, logname='analysis', 
                                                         structurefile=input.pdb, indexfile=output.index,
                                                         group1=GROUP1, group2=GROUP2, dna=DNA, phos=PHOS)

        with open(output.groups, "w") as f:
            json.dump(
                {
                    "group1": index_group1,
                    "group2": index_group2
                },
                f
            )

rule hbonds_gmx:
    params:
        gmxdir = lambda wc: f"{PATH_GMX_WC(wc)}",
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/002_hbonds_{GROUP1}_{GROUP2}",
        index_group1 = lambda wc, input: __import__("json").load(open(input.groups))["group1"],
        index_group2 = lambda wc, input: __import__("json").load(open(input.groups))["group2"]
    input:
        universe = f"{PATH_RAW}/universe",
        index = f"{PATH_GMX}/interaction_{GROUP1}_{GROUP2}.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    output:
        hbonds_gmx = f"{PATH_HBONDS}/hbonds_gmx.ndx",
        hbonds_gmx_num = f"{PATH_HBONDS}/hbonds_gmx_num.xvg"
    run:
        from scripts_analysis.hbonds_gmx import main
        main(
            logfile=logfile,
            universe=input.universe,
            gmxdir=params.gmxdir,
            outdir=params.outdir,
            indexfile=input.index,
            group1=params.index_group1,
            group2=params.index_group2,
            start=START,
            stop=STOP,
            dna=DNA,
            phos=PHOS
        )
    #shell:
    #    """
    #    {SCRIPTDIR}/hbonds_gmx.sh \
    #        --struct {wildcards.struct} \
    #        --mut {wildcards.mut} \
    #        --rep {wildcards.rep} \
    #    """


rule hbonds_gmx_parse:
    params:
        index_group1 = lambda wc, input: __import__("json").load(open(input.groups))["group1"],
        index_group2 = lambda wc, input: __import__("json").load(open(input.groups))["group2"]
    input:
        hbonds_gmx = f"{PATH_HBONDS}/hbonds_gmx.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    output:
        hbonds_gmx_parsed = f"{PATH_HBONDS}/hbonds_gmx_parsed.csv"
    run:
        from scripts_analysis.hbonds_gmx_parse import main
        main(
            logfile=logfile,
            hbonds_gmx=input.hbonds_gmx,
            hbonds_gmx_parsed=output.hbonds_gmx_parsed,
            group1=params.index_group1,
            group2=params.index_group2
        )
    #shell:
    #   """
    #   {SCRIPTDIR}/hbonds_gmx_parse.py \
    #        --ingmx {input.hbonds_gmx} \
    #        --outcsv {output.hbonds_gmx_parsed} \
    #   """


