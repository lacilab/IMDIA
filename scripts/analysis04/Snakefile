rule clustering_sklearn:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/005_clustering"
    input: 
        pdb = f"{PATH_GMX}/md_sys.pdb",
        xtc = f"{PATH_GMX}/md_post.xtc"
    output: 
        summary = report(f"{PATH_CLUST}/analysis_summary.txt",  
                    category="Clustering", labels={"sample": "{mut} {rep} Summary"}),
        hclust = f"{PATH_CLUST}/hclust_labels.csv",
        kmeans = f"{PATH_CLUST}/kmeans_labels.csv",
        hclust_timeline = report(f"{PATH_CLUST}/hclust_cluster_timeline.png",
                        category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {rep} Timeline"}),
        kmeans_timeline = report(f"{PATH_CLUST}/kmeans_cluster_timeline.png",
                            category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {rep} Timeline"}),
        umap_timeline = report(f"{PATH_CLUST}/umap_3d_timeline.png",
                            category="Clustering", labels={"sample": "{mut} {rep} UMAP timeline"}),
        umap_hclust_clusters = report(f"{PATH_CLUST}/umap_hclust_clusters.png",
                                category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {rep} Overlay on UMAP"}),
        umap_kmeans_clusters = report(f"{PATH_CLUST}/umap_kmeans_clusters.png",
                                category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {rep} Overlay on UMAP"}),
        umap_optimization = report(f"{PATH_CLUST}/umap_optimization.png",
                                category="Clustering", labels={"sample": "{mut} {rep} UMAP Optimization"}),
        pca_sk_hclust = report(f"{PATH_CLUST}/pca_sklearn_clusters_hclust.png",
                             category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {rep} Overlay on sklearn PCA"}),
        pca_sk_kmeans = report(f"{PATH_CLUST}/pca_sklearn_clusters_kmeans.png",
                            category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {rep} Overlay on sklearn PCA"}),
    shell:
        """
        {SCRIPTDIR}/clustering_sklearn.py \
            --pdb {input.pdb} \
            --xtc {input.xtc} \
            --outdir {params.outdir}
        """

