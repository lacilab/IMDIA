rule hbonds_plots:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/002_hbonds_{GROUP1}_{GROUP2}"
    input: 
        hbonds_ext = f"{PATH_HBONDS}/hbonds_{{method}}_ext.csv",
    output: 
        hbonds_prot_domains = report(f"{PATH_HBONDS}/hbonds_{{method}}_prot_domains.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per protein domain and residue"}),
        hbonds_prot_monomer = report(f"{PATH_HBONDS}/hbonds_{{method}}_monomer.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per protein monomer and atom"}),
        **out_hbond_plots_dna
    run:
        from scripts_analysis.hbonds_plots import main
        main(
            logfile=logfile,
            hbonds_ext=input.hbonds_ext,
            method=wildcards.method,
            dna=DNA,
            domains=DOMAINS,
            outfiles=dict(output)
        )
    #shell: 
    #    """
    #    {SCRIPTDIR}/hbonds_plots.py \
    #        --incsv {input.hbonds_ext} \
    #        --method {wildcards.method} \
    #        --outdir "{PATH_ANALYSIS_WC}/002_hbonds" \
    #    """

