# ------------------------
# Load configuration file
# ------------------------

logfile = config.get("logfile", None)

METHODS_HBONDS = config.get("methods_hbonds", ["gmx", "mda"])
STRUCTURES     = config.get("structure", [])
MUTS           = config.get("muts", [])
REPS           = config.get("reps", [])
DATADIR        = config.get("datadir", "data")
SCRIPTDIR     = config.get("scriptdir", "scripts/analysis04/scripts_analysis")
DNA            = config.get("dna", False)
PHOS           = config.get("phosphate", False)
OFFSET         = int(config.get("offset", 0))
DOMAINS        = config.get("domains", [])


# ------------------------
# Get replicates to analyze
# ------------------------
# List to store mutation-sample pairs as tuples
combinations = []

# Get first-level directories starting with rep for each mutation in MUTS
for structure in STRUCTURES:
    for mutation in MUTS:
        if len(REPS) < 1:
            reps = [d for d in os.listdir(f"{DATADIR}/{structure}/{mutation}/") 
                        if os.path.isdir(os.path.join(f"{DATADIR}/{structure}/{mutation}/", d)) 
                        and d.startswith("rep")]
        else:
            reps = REPS
            # TODO check if input rep directories exist
        for rep in reps:
            combinations.append((structure, mutation, rep))

# Print the pairs
print ("Structure-Mutation-Sample combinations to be analyzed:")
for structure, mutation, rep in combinations:
    print(f"Structure: {structure}, Mutation: {mutation}, Replicate: {rep}")
print("Hydrogen bonds analysis methods to be used:", METHODS_HBONDS)

structures, mutations, reps = zip(*combinations)

print("os.getcwd():", os.getcwd())

# PATHS
PATH_MUT = f"{DATADIR}" + "/{struct}/{mut}"
PATH_REP = f"{PATH_MUT}" + "/{rep}"
PATH_ANALYSIS = f"{PATH_REP}" + "/analysis"
PATH_MUT_OUT = f"{DATADIR}" + "/{{struct}}/{{mut}}"
PATH_REP_OUT = f"{PATH_MUT_OUT}" + "/{{rep}}"
PATH_ANALYSIS_OUT = f"{PATH_REP_OUT}" + "/analysis"
PATH_ANALYSIS_WC = lambda wc: f"{DATADIR}/{wc.struct}/{wc.mut}/{wc.rep}/analysis"
PATH_GMX_WC = lambda wc: f"{DATADIR}/{wc.struct}/{wc.mut}/{wc.rep}/gromacs"
PATH_GMX = f"{PATH_REP}" + "/gromacs"
PATH_RAW = f"{PATH_ANALYSIS}" + "/000_raw"
PATH_QC = f"{PATH_ANALYSIS}" + "/001_qc"
PATH_HBONDS = f"{PATH_ANALYSIS}" + "/002_hbonds"
PATH_PCA = f"{PATH_ANALYSIS}" + "/003_pca"
PATH_CONTACTS = f"{PATH_ANALYSIS}" + "/004_contacts"
PATH_CLUST = f"{PATH_ANALYSIS}" + "/005_clustering"
