rule clustering_pca_gmx:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/005_clustering"
    input: 
        proj_timescale = f"{PATH_PCA}/2dproj_timescale.csv",
        hclust = f"{PATH_CLUST}/hclust_labels.csv",
        kmeans = f"{PATH_CLUST}/kmeans_labels.csv",
    output: 
        pca_gmx_hclust = report(f"{PATH_CLUST}/pca_gmx_clusters_hclust.jpg", 
                        category="Clustering", subcategory="Hiearchical clustering", labels={"sample": "{mut} {rep} Overlay on gmx PCA"}),
        pca_gmx_kmeans = report(f"{PATH_CLUST}/pca_gmx_clusters_kmeans.jpg",
                         category="Clustering", subcategory="Kmeans clustering", labels={"sample": "{mut} {rep} Overlay on gmx PCA"}),
    run:
        from scripts_analysis.clustering_pca_gmx import main
        main(
            logfile=logfile,
            timescale=input.proj_timescale,
            clust_labels=input.hclust,
            clust_alg ="hclust",
            outdir=params.outdir
        )
        main(
            logfile=logfile,
            timescale=input.proj_timescale,
            clust_labels=input.kmeans,
            clust_alg ="kmeans",
            outdir=params.outdir
        )
    #shell:
    #    """
    #    {SCRIPTDIR}/clustering_pca_gmx.py \
    #        --timescale {input.proj_timescale} \
    #        --labels {input.hclust} \
    #        --outdir "{params.outdir}" \
    #
    #    {SCRIPTDIR}/clustering_pca_gmx.py \
    #        --timescale {input.proj_timescale} \
    #        --labels {input.kmeans} \
    #        --outdir "{params.outdir}" \
    #    """
        
rule gbsa:
    params:
        index_group1 = lambda wc, input: __import__("json").load(open(input.groups))["group1"],
        index_group2 = lambda wc, input: __import__("json").load(open(input.groups))["group2"],
        gmxdir = lambda wc: f"{PATH_GMX_WC(wc)}",
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/006_gbsa_{GROUP1}_{GROUP2}",
        scriptdir = SCRIPTDIR,
    threads: workflow.cores * 0.95
    input: 
        tpr = f"{PATH_GMX}/md.tpr",
        xtc = f"{PATH_GMX}/md_post.xtc",
        top = f"{PATH_MUT}/gromacs_common/topol.top",
        index = f"{PATH_GMX}/interaction_{GROUP1}_{GROUP2}.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    output: 
        gbsa_info = f"{PATH_GBSA}/_GMXMMPBSA_info",
        gbsa_final_results = f"{PATH_GBSA}/FINAL_RESULTS_MMPBSA.dat",
        gbsa_final_decomp = f"{PATH_GBSA}/FINAL_DECOMP_MMPBSA.dat",
        gbsa_energy = f"{PATH_GBSA}/FINAL_ENERGY.csv",
        gbsa_energy_decomp = f"{PATH_GBSA}/FINAL_ENERGY_DECOMP.csv",
    run:
        from scripts_analysis.gbsa import main
        main(
            logfile=logfile,
            scriptdir=params.scriptdir,
            gmxdir=params.gmxdir,
            outdir=params.outdir,
            index = input.index,
            tprfile=input.tpr,
            xtcfile=input.xtc,
            topfile=input.top,
            cores=threads,
            index_group1=params.index_group1,
            index_group2=params.index_group2,
            start=START,
            stop=STOP,
            dna=DNA,
            phos=PHOS,
            ffs = ffs
        )
    #shell: 
    #    """
    #    {SCRIPTDIR}/MMPBSA.sh \
    #        --scriptdir "{params.scriptdir}" \
    #        --gmxdir "{params.gmxdir}" \
    #        --outdir "{params.outdir}" \
    #        --tpr {input.tpr} \
    #        --xtc {input.xtc} \
    #        --top {input.top} \
    #    """