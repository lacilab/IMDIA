# Run MM/GBSA (Molecular Mechanics/Generalized Born Surface Area) free binding energy calculations        
rule gbsa:
    params:
        index_group1 = lambda wc, input: __import__("json").load(open(input.groups))["group1"],
        index_group2 = lambda wc, input: __import__("json").load(open(input.groups))["group2"],
        gmxdir = lambda wc: f"{PATH_GMX_WC(wc)}",
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/gbsa_{GROUP1}_{GROUP2}",
        scriptdir = SCRIPTDIR,
    threads: min(int(workflow.cores * 0.95), 64)
    input: 
        tpr = f"{PATH_GMX}/md.tpr",
        xtc = f"{PATH_GMX}/md_post.xtc",
        top = f"{PATH_MUT}/gromacs_common/topol.top",
        index = f"{PATH_GMX}/interaction_{GROUP1}_{GROUP2}.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    output: 
        gbsa_info = f"{PATH_GBSA}/_GMXMMPBSA_info",
        gbsa_final_results = f"{PATH_GBSA}/FINAL_RESULTS_MMPBSA.dat",
        gbsa_final_decomp = f"{PATH_GBSA}/FINAL_DECOMP_MMPBSA.dat",
        gbsa_energy = f"{PATH_GBSA}/FINAL_ENERGY.csv",
        gbsa_energy_decomp = f"{PATH_GBSA}/FINAL_ENERGY_DECOMP.csv",
    run:
        from scripts_analysis.gbsa import main
        main(
            logfile=LOGFILE,
            scriptdir=params.scriptdir,
            gmxdir=params.gmxdir,
            outdir=params.outdir,
            index = input.index,
            tprfile=input.tpr,
            xtcfile=input.xtc,
            topfile=input.top,
            cores=threads,
            index_group1=params.index_group1,
            index_group2=params.index_group2,
            start=START,
            stop=STOP,
            dna=DNA,
            phos=PHOS,
            ffs=FFS
        )


# Plot GBSA results       
rule gbsa_plots:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/gbsa_{GROUP1}_{GROUP2}"
    input: 
        gbsa_total = f"{PATH_GBSA}/FINAL_ENERGY.csv",
        gbsa_res = f"{PATH_GBSA}/FINAL_ENERGY_DECOMP.csv",
    output: 
        full_totalenergy = report(f"{PATH_GBSA}/gbsa_full_totalenergy.png", category="GBSA", labels={"sample": "{mut} {rep} Total Energy"}),
        res_totalenergy = report(f"{PATH_GBSA}/gbsa_res_totalenergy.png", category="GBSA", labels={"sample": "{mut} {rep} Total Energy by residue"}),
    run:
        from scripts_analysis.gbsa_plots import main

        energy_total = Path(input.gbsa_total)
        energy_decomp = Path(input.gbsa_res)
        outdir = Path(params.outdir)

        main(
            logfile=LOGFILE,
            energy_total=energy_total,
            energy_decomp=energy_decomp,
            offsets=OFFSETS,
            outdir=outdir
        )