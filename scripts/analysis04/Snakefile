from pathlib import Path
import os

# ------------------------
# Load configuration file
# ------------------------
# print("Loading configuration and setting up parameters...")
LOGFILE        = config.get("logfile", None)
DATADIR        = config.get("datadir", "data")
rule_groups    = config.get("rule_groups", "").split(' ')

SCRIPTDIR      = os.path.join(os.path.dirname(workflow.snakefile), "scripts_analysis")
METHODS_HBONDS = config.get("methods_hbonds", ["gmx", "mda"])
STRUCTURES     = config.get("structure", [])
MUTS           = config.get("muts", [])
REPS           = config.get("repn", [])
DNA            = config.get("dna", False)
PHOS           = config.get("phos", False)
DOMAINS        = config.get("domains", {})
GROUP1         = config.get("group1", None)
GROUP2         = config.get("group2", None)
CHAINGROUPS    = config.get("chaingroups", {})
START          = config.get("start_frame", 0)     
STOP           = config.get("stop_frame", None)
FFS            = config.get("ffs", None)
OFFSETS        = config.get("chains", {})


##### GET REPLICATES TO ANALYZE #####
combinations = []
# Get first-level directories starting with rep for each mutation in MUTS
for structure in STRUCTURES:
    for mutation in MUTS:
        if len(REPS) < 1:
            reps = [d for d in os.listdir(f"{DATADIR}/{structure}/{mutation}/") 
                        if os.path.isdir(os.path.join(f"{DATADIR}/{structure}/{mutation}/", d)) 
                        and d.startswith("rep")]
        else:
            reps = []
            for n in REPS:
                if os.path.isdir(f"{DATADIR}/{structure}/{mutation}/rep{n}"):
                    reps.append(f"rep{n}")
        for rep in reps:
            if os.path.isdir(f"{DATADIR}/{structure}/{mutation}/{rep}"):
                combinations.append((structure, mutation, rep))

structures, mutations, reps = zip(*combinations)

##### CHECK INTERACTION GROUPS #####
# Check if rules contain interaction analysis and if group1 and group2 are defined
interaction_rules = ["hbonds", "wb", "contacts", "gbsa"]
if any(rule in rule_groups for rule in interaction_rules) or rule_groups == [""]:
    if GROUP1 is None or GROUP2 is None:
        raise ValueError("Both GROUP1 and GROUP2 must be defined in the config file when running interaction analysis rules.")

###### PATHS ######
PATH_MUT = Path(DATADIR) / "{struct}" / "{mut}"
PATH_REP = PATH_MUT / "{rep}"
PATH_ANALYSIS = PATH_REP / "analysis"
PATH_MUT_OUT = Path(DATADIR) / "{struct}" / "{mut}"
PATH_REP_OUT = PATH_MUT_OUT / "{rep}"
PATH_ANALYSIS_OUT = PATH_REP_OUT / "analysis"
PATH_ANALYSIS_WC = lambda wc: Path(DATADIR) / wc.struct / wc.mut / wc.rep / "analysis"
PATH_GMX_WC = lambda wc: Path(DATADIR) / wc.struct / wc.mut / wc.rep / "gromacs"
PATH_GMX = PATH_REP / "gromacs"
PATH_RAW = PATH_ANALYSIS / "000_raw"
PATH_QC = PATH_ANALYSIS / "001_qc"
PATH_HBONDS = PATH_ANALYSIS / f"002_hbonds_{GROUP1}_{GROUP2}" 
PATH_PCA = PATH_ANALYSIS / "003_pca"
PATH_CONTACTS = PATH_ANALYSIS / f"004_contacts_{GROUP1}_{GROUP2}"
PATH_CLUST = PATH_ANALYSIS / "005_clustering"
PATH_GBSA= PATH_ANALYSIS / f"006_gbsa_{GROUP1}_{GROUP2}"


###### CONDITIONAL OUTPUT - RUN CERTAIN RULES BASED ON INPUT LIST ######
# Conditional I/O files
all_input = {}
out_rmsf = {}
out_hbonds_plots = {}
if len(CHAINGROUPS) > 0: 
    all_input["rmsf_chaingroups"] = expand(f"{PATH_QC}/rmsf_chaingroups.png", struct=structures, mut=mutations, rep=reps, zip=True)
if "qc" in rule_groups or rule_groups == [""]:
    if DNA:
        out_rmsf["rmsf_dna"] = report(f"{PATH_QC}/rmsf_dna.png", 
                category="QC", subcategory="RMSF", labels={"sample": "{mut} {rep} RMSF DNA"})
        out_rmsf["rmsf_dna_csv"] = f"{PATH_QC}/rmsf_dna.csv"
        all_input["rmsf_dna"] = expand(f"{PATH_QC}/rmsf_dna.png", struct=structures, mut=mutations, rep=reps, zip=True)
        all_input["rmsf_dna_csv"] = expand(f"{PATH_QC}/rmsf_dna.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["rmsdpng"] = expand(f"{PATH_QC}/rmsd.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["rmsd_cats"] = expand(f"{PATH_QC}/rmsd_cats.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["rmsd_bb"] = expand(f"{PATH_QC}/rmsd_bb.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["radius_axis"] = expand(f"{PATH_QC}/radius_axis.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["radius_rmsd"] = expand(f"{PATH_QC}/radius_rmsd.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["rmsf_prot"] = expand(f"{PATH_QC}/rmsf_prot.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["rmsd_csv"] = expand(f"{PATH_QC}/rmsd.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["radius_axis_csv"] = expand(f"{PATH_QC}/radius_axis.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["rmsf_prot_csv"] = expand(f"{PATH_QC}/rmsf_prot.csv", struct=structures, mut=mutations, rep=reps, zip=True)
if "hbonds" in rule_groups or rule_groups == [""]:
    if "gmx" in METHODS_HBONDS:
        all_input["hbonds_gmx"] = expand(f"{PATH_HBONDS}/hbonds_gmx.ndx", struct=structures, mut=mutations, rep=reps, zip=True)
        all_input["hbonds_gmx_num"] = expand(f"{PATH_HBONDS}/hbonds_gmx_num.xvg", struct=structures, mut=mutations, rep=reps, zip=True)
        all_input["hbonds_gmx_parsed"] = expand(f"{PATH_HBONDS}/hbonds_gmx_parsed.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    if "mda" in METHODS_HBONDS:
        all_input["hbonds_mda_parsed"] = expand(f"{PATH_HBONDS}/hbonds_mda_parsed.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    if "Protein" in [GROUP1, GROUP2]:
        all_input["hbonds_prot_chains"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_protein_perchain.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
        out_hbonds_plots["hbonds_prot_chains"] = report(f"{PATH_HBONDS}/hbonds_{{method}}_protein_perchain.png", category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Protein hydrogen bonds"})
    if "DNA" in [GROUP1, GROUP2]:
        all_input["hbonds_dna_chains"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_dna_perchain.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
        out_hbonds_plots["hbonds_dna_chains"] = report(f"{PATH_HBONDS}/hbonds_{{method}}_dna_perchain.png", category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} DNA hydrogen bonds"})
    all_input["hbonds_perframe"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_perframe.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
    all_input["hbonds_ext"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_ext.csv", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
    all_input["hbonds_per_group"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_per_group.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
    all_input["hbonds_heatmap"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_heatmap.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
    all_input["hbonds_pymol"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_pymol.txt", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
if "wb" in rule_groups or rule_groups == [""]:
    all_input["water_bridges"] = expand(f"{PATH_HBONDS}/waterbridges.csv", struct=structures, mut=mutations, rep=reps, zip=True)
if "contacts" in rule_groups or rule_groups == [""]:
    all_input["timeseries_full_csv"] = expand(f"{PATH_CONTACTS}/timeseries_full.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["timeseries_full_png"] = expand(f"{PATH_CONTACTS}/timeseries_full.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pairs_full_csv"] = expand(f"{PATH_CONTACTS}/pairs_full.csv", struct=structures, mut=mutations, rep=reps, zip=True)
if "pca" in rule_groups or rule_groups == [""]:
    all_input["pca_proj_xvg"] = expand(f"{PATH_PCA}/proj_10.xvg", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_proj_csv"] = expand(f"{PATH_PCA}/proj_10.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_proj_png"] = expand(f"{PATH_PCA}/pc1_pc2.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_cosine"] = expand(f"{PATH_PCA}/pc_cosine.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_cumulative"] = expand(f"{PATH_PCA}/cum_var.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_pairgrid"] = expand(f"{PATH_PCA}/pc_pairgrid.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_rmsf"] = expand(f"{PATH_PCA}/pc_rmsf.png", struct=structures, mut=mutations, rep=reps, zip=True)
if "clust" in rule_groups or rule_groups == [""]:
    all_input["clust_kmeans"] = expand(f"{PATH_CLUST}/clust_kmeans.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_kmeans_sizes"] = expand(f"{PATH_CLUST}/clust_kmeans_sizes.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_kmeans_time"] = expand(f"{PATH_CLUST}/clust_kmeans_time.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_hclust"] = expand(f"{PATH_CLUST}/clust_hierarchical.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_hclust_sizes"] = expand(f"{PATH_CLUST}/clust_hierarchical_sizes.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_hclust_time"] = expand(f"{PATH_CLUST}/clust_hierarchical_time.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_scores"] = expand(f"{PATH_CLUST}/clust_silhouette.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_summary"] = expand(f"{PATH_CLUST}/summary.txt", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["clust_csv"] = expand(f"{PATH_CLUST}/pca_clusters.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    # Gromos
    all_input["gromos_xpm"] = expand(f"{PATH_CLUST}/gromos_clusters.xpm", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_log"] = expand(f"{PATH_CLUST}/gromos_clusters.log", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_gromos"] = expand(f"{PATH_CLUST}/pca_gromos_clusters.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["pca_gromos_top10"] = expand(f"{PATH_CLUST}/pca_gromos_clusters_top10.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_clusters_freq"] = expand(f"{PATH_CLUST}/gromos_clusters_freq.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_clusters_ids"] = expand(f"{PATH_CLUST}/gromos_clust_ids.xvg", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_clust_ids_plot"] = expand(f"{PATH_CLUST}/gromos_clust_ids.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_clust_size"] = expand(f"{PATH_CLUST}/gromos_clust_size.xvg", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_clusters_eps"] = expand(f"{PATH_CLUST}/gromos_clusters.eps", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_clusters_png"] = expand(f"{PATH_CLUST}/gromos_clusters.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_clust_dist"] = expand(f"{PATH_CLUST}/gromos_rmsd_dist.png", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gromos_pca_csv"] = expand(f"{PATH_CLUST}/pca_clusters_ext.csv", struct=structures, mut=mutations, rep=reps, zip=True)
if "gbsa" in rule_groups or rule_groups == [""]:
    all_input["gbsa_info"] = expand(f"{PATH_GBSA}/_GMXMMPBSA_info", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gbsa_final_results"] = expand(f"{PATH_GBSA}/FINAL_RESULTS_MMPBSA.dat", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gbsa_final_decomp"] = expand(f"{PATH_GBSA}/FINAL_DECOMP_MMPBSA.dat", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gbsa_energy"] = expand(f"{PATH_GBSA}/FINAL_ENERGY.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    all_input["gbsa_energy_decomp"] = expand(f"{PATH_GBSA}/FINAL_ENERGY_DECOMP.csv", struct=structures, mut=mutations, rep=reps, zip=True)


onstart:
    print("""
            +------------------------------------+
            |   STARTING ANALYSIS OF MD RESULTS  |
            +------------------------------------+""")
    print("Working directory:", os.getcwd())
    print(f"Structure-Mutation-Sample combinations to be analyzed, found in directory {DATADIR}:")
    for structure, mutation, rep in combinations:
        print(f"Structure: {structure}, Mutation: {mutation}, Replicate: {rep}")
    print("Hydrogen bonds analysis methods to be used:", METHODS_HBONDS)
    print(f"Chaingroups defined for analysis: {CHAINGROUPS}")
    print(f"Received offset dictionary: {OFFSETS}")
    print(f"Received domains dictionary: {DOMAINS}")
    print(f"Interaction analysis will be performed between groups: {GROUP1} and {GROUP2}")


##### RULES #####
rule all:
    input:
        **all_input
    run:
        print("All specified rules have been executed. Final outputs are available.")

rule universe:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/000_raw"
    input:
        pdb = f"{PATH_GMX}/md_sys.pdb",
        xtc = f"{PATH_GMX}/md_post.xtc"
    output:
        universe = f"{PATH_RAW}/universe"
    run:
        from scripts_analysis.universe import main
        main(
            logfile=LOGFILE,
            pdbfile=input.pdb,
            xtcfile=input.xtc,
            outdir=params.outdir,
            universe=output.universe
        )



rule qc:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/001_qc"
    input: 
        universe = f"{PATH_RAW}/universe"
    output:
        rmsd = report(f"{PATH_QC}/rmsd.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} RMSD"}),
        rmsd_cats = report(f"{PATH_QC}/rmsd_cats.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} RMSD by category"}),
        rmsd_bb = report(f"{PATH_QC}/rmsd_bb.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} RMSD Backbone"}),
        radius_axis = report(f"{PATH_QC}/radius_axis.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} Radius of gyration"}),
        radius_rmsd = report(f"{PATH_QC}/radius_rmsd.png", 
            category="QC", subcategory="RMSD", labels={"sample": "{mut} {rep} Radius of gyration vs RMSD"}),
        rmsf_prot = report(f"{PATH_QC}/rmsf_prot.png", 
            category="QC", subcategory="RMSF", labels={"sample": "{mut} {rep} RMSF Protein"}),
        rmsd_csv = f"{PATH_QC}/rmsd.csv",
        radius_axis_csv = f"{PATH_QC}/radius_axis.csv",
        rmsf_prot_csv = f"{PATH_QC}/rmsf_prot.csv",
        rmsf_chaingroups = f"{PATH_QC}/rmsf_chaingroups.png",
        **out_rmsf
    run:
        from scripts_analysis.qc import main
        main(
            logfile=LOGFILE,
            universe=input.universe,
            outdir=params.outdir,
            outfiles=dict(output),
            with_dna=DNA,
            offsets=OFFSETS,
            domains=DOMAINS,
            chaingroups=CHAINGROUPS
        )



# Get interaction group names in the index file
rule interaction_index:
    params:
        gmxdir = lambda wc: f"{PATH_GMX_WC(wc)}",
    input:
        pdb = f"{PATH_GMX}/md_sys.pdb",
    output:
        index = f"{PATH_GMX}/interaction_{GROUP1}_{GROUP2}.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    run:
        from scripts.utils.group_index import group_index_interactions
        import json

        index_group1, index_group2 = group_index_interactions(gmxdir=params.gmxdir, logfile=LOGFILE, logname='analysis', 
                                                         structurefile=input.pdb, indexfile=output.index,
                                                         group1=GROUP1, group2=GROUP2, dna=DNA, phos=PHOS)

        with open(output.groups, "w") as f:
            json.dump(
                {
                    "group1": index_group1,
                    "group2": index_group2
                },
                f
            )



rule hbonds_gmx:
    params:
        gmxdir = lambda wc: f"{PATH_GMX_WC(wc)}",
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/002_hbonds_{GROUP1}_{GROUP2}",
        index_group1 = lambda wc, input: __import__("json").load(open(input.groups))["group1"],
        index_group2 = lambda wc, input: __import__("json").load(open(input.groups))["group2"]
    input:
        universe = f"{PATH_RAW}/universe",
        index = f"{PATH_GMX}/interaction_{GROUP1}_{GROUP2}.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    output:
        hbonds_gmx = f"{PATH_HBONDS}/hbonds_gmx.ndx",
        hbonds_gmx_num = f"{PATH_HBONDS}/hbonds_gmx_num.xvg"
    run:
        from scripts_analysis.hbonds_gmx import main
        main(
            logfile=LOGFILE,
            universe=input.universe,
            gmxdir=params.gmxdir,
            outdir=params.outdir,
            indexfile=input.index,
            group1=params.index_group1,
            group2=params.index_group2,
            start=START,
            stop=STOP,
            dna=DNA,
            phos=PHOS
        )



rule hbonds_gmx_parse:
    params:
        index_group1 = lambda wc, input: __import__("json").load(open(input.groups))["group1"],
        index_group2 = lambda wc, input: __import__("json").load(open(input.groups))["group2"]
    input:
        hbonds_gmx = f"{PATH_HBONDS}/hbonds_gmx.ndx",
        groups = f"{PATH_GMX}/interaction_groups_{GROUP1}_{GROUP2}.json"
    output:
        hbonds_gmx_parsed = f"{PATH_HBONDS}/hbonds_gmx_parsed.csv"
    run:
        from scripts_analysis.hbonds_gmx_parse import main
        main(
            logfile=LOGFILE,
            hbonds_gmx=input.hbonds_gmx,
            hbonds_gmx_parsed=output.hbonds_gmx_parsed,
            group1=params.index_group1,
            group2=params.index_group2
        )



rule hbonds_mda:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/002_hbonds_{GROUP1}_{GROUP2}"
    threads: min(int(workflow.cores), 64)
    input: 
        universe = f"{PATH_RAW}/universe",
        tpr = f"{PATH_GMX}/md.tpr",
        xtc = f"{PATH_GMX}/md_post.xtc"
    output: 
        hbonds_mda_parsed = f"{PATH_HBONDS}/hbonds_mda_parsed.csv"
    run:
        from scripts_analysis.hbonds_mda import main
        main(
            logfile=LOGFILE,
            universe=input.universe,
            tprfile=input.tpr,
            xtcfile=input.xtc,
            outdir=params.outdir,
            hbonds_mda_parsed=output.hbonds_mda_parsed,
            cores=threads,
            group1=GROUP1,
            group2=GROUP2,
            start=START,
            stop=STOP,
            dna=DNA
        )



rule hbonds_extend:
    input: 
        universe = f"{PATH_RAW}/universe",
        hbonds_parsed = f"{PATH_HBONDS}/hbonds_{{method}}_parsed.csv",
        pdb = f"{PATH_GMX}/md_sys.pdb",
    output: 
        hbonds_ext = f"{PATH_HBONDS}/hbonds_{{method}}_ext.csv",
        hbonds_perframe = report(f"{PATH_HBONDS}/hbonds_{{method}}_perframe.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per frame (last 100ns)"})
    run:
        from scripts_analysis.hbonds_extend import main
        main(
            logfile=LOGFILE,
            pdbfile=input.pdb,
            universe=input.universe,
            hbonds_parsed=input.hbonds_parsed,
            hbonds_ext=output.hbonds_ext,
            hbonds_perframe=output.hbonds_perframe,
            offsets=OFFSETS,
            domains=DOMAINS,
            chaingroups=CHAINGROUPS, 
            chains=OFFSETS,
        )



rule hbonds_plots:
    params:
        outdir = lambda wc: f"{PATH_ANALYSIS_WC(wc)}/002_hbonds_{GROUP1}_{GROUP2}"
    input: 
        hbonds_ext = f"{PATH_HBONDS}/hbonds_{{method}}_ext.csv",
        hbonds_parsed = f"{PATH_HBONDS}/hbonds_{{method}}_parsed.csv",
    output: 
        hbonds_per_group = report(f"{PATH_HBONDS}/hbonds_{{method}}_per_group.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per interaction group."}),
        hbonds_heatmap = report(f"{PATH_HBONDS}/hbonds_{{method}}_heatmap.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbond heatmap"}),
        **out_hbonds_plots
    run:
        from scripts_analysis.hbonds_plots import main
        main(
            logfile=LOGFILE,
            hbonds_parsed=input.hbonds_parsed,
            hbonds_ext=input.hbonds_ext,
            domains=DOMAINS,
            chaingroups=CHAINGROUPS,
            group1=GROUP1,
            group2=GROUP2,
            outfiles=dict(output)
        )



rule hbonds_pymol:
    input: 
        hbonds_ext = f"{PATH_HBONDS}/hbonds_{{method}}_ext.csv",
    output: 
        hbonds_pymol = f"{PATH_HBONDS}/hbonds_{{method}}_pymol.txt",
    run:
        from scripts_analysis.hbonds_pymol import main
        main(
            logfile=LOGFILE,
            hbonds_ext=input.hbonds_ext,
