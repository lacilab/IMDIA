# ------------------------
# Load configuration file
# ------------------------

logfile = config.get("logfile", None)
rule_groups = config.get("rule_groups", "").split(' ')
ffs = config.get("ffs", None)
if ffs is not None:
    ffs = ffs.split(' ')

METHODS_HBONDS = config.get("methods_hbonds", ["gmx", "mda"])
STRUCTURES     = config.get("structure", [])
MUTS           = config.get("muts", [])
REPS           = config.get("reps", [])
DATADIR        = config.get("datadir", "data")
SCRIPTDIR     = config.get("scriptdir", "scripts/analysis04/scripts_analysis")
DNA            = config.get("dna", False)
PHOS           = config.get("phosphate", False)
OFFSET         = int(config.get("offset", 0))
DOMAINS        = config.get("domains", [])
GROUP1         = config.get("group1", None)
GROUP2         = config.get("group2", None)
START          = config.get("start_frame", None)     
STOP           = config.get("stop_frame", None)


# ------------------------
# Get replicates to analyze
# ------------------------
# List to store mutation-sample pairs as tuples
combinations = []

# Get first-level directories starting with rep for each mutation in MUTS
for structure in STRUCTURES:
    for mutation in MUTS:
        if len(REPS) < 1:
            reps = [d for d in os.listdir(f"{DATADIR}/{structure}/{mutation}/") 
                        if os.path.isdir(os.path.join(f"{DATADIR}/{structure}/{mutation}/", d)) 
                        and d.startswith("rep")]
        else:
            reps = REPS
            # TODO check if input rep directories exist
        for rep in reps:
            combinations.append((structure, mutation, rep))

# Print the pairs
print ("Structure-Mutation-Sample combinations to be analyzed:")
for structure, mutation, rep in combinations:
    print(f"Structure: {structure}, Mutation: {mutation}, Replicate: {rep}")
print("Hydrogen bonds analysis methods to be used:", METHODS_HBONDS)

structures, mutations, reps = zip(*combinations)

print("os.getcwd():", os.getcwd())

###### PATHS ######
PATH_MUT = f"{DATADIR}" + "/{struct}/{mut}"
PATH_REP = f"{PATH_MUT}" + "/{rep}"
PATH_ANALYSIS = f"{PATH_REP}" + "/analysis"
PATH_MUT_OUT = f"{DATADIR}" + "/{{struct}}/{{mut}}"
PATH_REP_OUT = f"{PATH_MUT_OUT}" + "/{{rep}}"
PATH_ANALYSIS_OUT = f"{PATH_REP_OUT}" + "/analysis"
PATH_ANALYSIS_WC = lambda wc: f"{DATADIR}/{wc.struct}/{wc.mut}/{wc.rep}/analysis"
PATH_GMX_WC = lambda wc: f"{DATADIR}/{wc.struct}/{wc.mut}/{wc.rep}/gromacs"
PATH_GMX = f"{PATH_REP}" + "/gromacs"
PATH_RAW = f"{PATH_ANALYSIS}" + "/000_raw"
PATH_QC = f"{PATH_ANALYSIS}" + "/001_qc"
PATH_HBONDS = f"{PATH_ANALYSIS}/002_hbonds_{GROUP1}_{GROUP2}" 
PATH_PCA = f"{PATH_ANALYSIS}" + "/003_pca"
PATH_CONTACTS = f"{PATH_ANALYSIS}/004_contacts_{GROUP1}_{GROUP2}"
PATH_CLUST = f"{PATH_ANALYSIS}" + "/005_clustering"
PATH_GBSA= f"{PATH_ANALYSIS}/006_gbsa_{GROUP1}_{GROUP2}"

###### CONDITIONAL OUTPUT - RUN CERTAIN RULES BASED ON INPUT LIST ######
# Conditional I/O files
out_rmsf_dna = {}
in_rmsf_dna = {}
out_hbond_plots_dna = {}
in_hbond_plots_dna = {}
if DNA:
    out_rmsf_dna["rmsf_dna_res"] = report(f"{PATH_QC}/rmsf_dna_res.png", 
            category="QC", subcategory="RMSF", labels={"sample": "{mut} {rep} RMSF DNA"})
    out_rmsf_dna["rmsf_dna_csv"] = f"{PATH_QC}/rmsf_dna.csv"
    in_rmsf_dna["rmsf_dna_res"] = expand(f"{PATH_QC}/rmsf_dna_res.png", struct=structures, mut=mutations, rep=reps, zip=True)
    in_rmsf_dna["rmsf_dna_csv"] = expand(f"{PATH_QC}/rmsf_dna.csv", struct=structures, mut=mutations, rep=reps, zip=True)
    out_hbond_plots_dna["hbonds_dna"] = report(f"{PATH_HBONDS}/hbonds_{{method}}_dna.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per DNA chain and residue"})
    out_hbond_plots_dna["hbonds_dna_bb"] = report(f"{PATH_HBONDS}/hbonds_{{method}}_dna_bb.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per DNA backbone"})
    out_hbond_plots_dna["hbonds_dna_base"] = report(f"{PATH_HBONDS}/hbonds_{{method}}_dna_base.png", 
            category="Hbonds", subcategory="{method}", labels={"sample": "{mut} {rep} Hbonds per DNA base"})
    in_hbond_plots_dna["hbonds_dna"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_dna.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
    in_hbond_plots_dna["hbonds_dna_bb"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_dna_bb.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)
    in_hbond_plots_dna["hbonds_dna_base"] = expand(f"{PATH_HBONDS}/hbonds_{{method}}_dna_base.png", struct=structures, mut=mutations, rep=reps, method=METHODS_HBONDS, zip=True)

